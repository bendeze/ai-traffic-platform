# ========================================================
#   AI TRAFFIC MANAGEMENT PLATFORM — BACKEND CONFIGURATION
#   Carnegie Mellon University - Bridge Program (Group 5)
# ========================================================

# ── VISION & CAMERA SETTINGS ────────────────────────────
# Mode: "tracking" (continuous ByteTrack) or "snapshot" (periodic photo sampling)
VISION_MODE=snapshot

# Photo sampling interval in seconds (used when VISION_MODE=snapshot)
SNAPSHOT_INTERVAL=5.0

# YOLO model weights and detection confidence threshold
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.35

# ── SIGNAL TIMING PARAMETERS (SECONDS) ──────────────────
# Minimum time a green phase must hold before changing
MIN_GREEN=10

# Maximum continuous green time before forcing a transition
MAX_GREEN=60

# Standard yellow duration for vehicular transition warning
YELLOW_DURATION=3

# Extended yellow warning duration for pedestrian crosswalk requests
PEDESTRIAN_YELLOW_DURATION=10

# All-red clearance interval between conflicting phases
CLEARANCE_DURATION=2

# Maximum wait time allowed before forcing a fair transition (anti-starvation cap)
MAX_WAIT_SECONDS=30.0

# Decision engine evaluation cycle interval (seconds)
EVAL_INTERVAL=2.0

# Ratio of demand required to trigger phase switch (e.g. 1.25 = 25% more demand needed)
DEMAND_SWITCH_THRESHOLD=1.25

# ── ARDUINO HARDWARE SERIAL INTERFACE ───────────────────
# Set to "true" to activate USB serial communication with Arduino Nano 33 BLE
SERIAL_ENABLED=true

# Set to "auto" for dynamic OS port discovery, or specify a port (e.g. COM6, /dev/ttyACM0)
SERIAL_PORT=auto

# Baud rate for serial communication (default 9600)
SERIAL_BAUD_RATE=9600

# ── BACKEND SERVER ──────────────────────────────────────
HOST=0.0.0.0
PORT=8000

