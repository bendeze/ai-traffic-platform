# ========================================================
#   GROUP Z - AI TRAFFIC MANAGEMENT SYSTEM CONFIGURATION
#   Carnegie Mellon University - Bridge Program
# ========================================================

# ── VISION & CAMERA SETTINGS ────────────────────────────
# Mode: "tracking" (continuous ByteTrack) or "snapshot" (photo every N seconds)
VISION_MODE=snapshot

# Photo sampling interval in seconds (used when VISION_MODE=snapshot)
SNAPSHOT_INTERVAL=5.0

# YOLO model weights and detection confidence threshold
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.35

# ── ADAPTIVE SIGNAL TIMING PARAMETERS (SECONDS) ─────────
# Minimum green duration (5.0s allows quick early-clearing without sluggish dead time)
MIN_GREEN=5

# Maximum continuous green time before forcing a transition
MAX_GREEN=60

# Standard yellow duration across the entire system (strictly 2.0s)
YELLOW_DURATION=2

# Extended yellow warning duration for pedestrian crosswalk requests (strictly 2.0s)
PEDESTRIAN_YELLOW_DURATION=2

# All-red clearance interval between conflicting phases (removed: 0s)
CLEARANCE_DURATION=0

# Maximum wait time allowed before forcing a fair transition (anti-starvation cap)
MAX_WAIT_SECONDS=30.0

# Decision engine evaluation cycle interval in seconds (0.5s for fast real-time responsiveness)
EVAL_INTERVAL=0.5

# Ratio of demand required to trigger phase switch (1.10 = 10% more demand)
DEMAND_SWITCH_THRESHOLD=1.10

# ── EMERGENCY AMBULANCE PREEMPTION ──────────────────────
# Distance in meters from stopline to trigger preemption (55.0m = ~4.0s before arrival at 50 km/h)
# Prevents holding empty green lights while the ambulance is still far away
AMBULANCE_PREEMPTION_DISTANCE=55.0

# ── EARLY GAP-OUT & QUEUE OPTIMIZATION ──────────────────
# Immediate termination of green phase when queue reaches 0 and other phase has waiting traffic
GAP_OUT_ENABLED=true
GAP_OUT_QUEUE_THRESHOLD=0.2

# ── VEHICLE CLASSIFICATION WEIGHTS ──────────────────────
# Weight multipliers applied to waiting queues based on vehicle size & passenger capacity
WEIGHT_BUS=3.0
WEIGHT_TRUCK=2.0
WEIGHT_CAR=1.0
WEIGHT_MOTORCYCLE=0.8
WEIGHT_BICYCLE=0.5

# ── SIMULATION & EVALUATION SETTINGS ────────────────────
# Default evaluation duration in simulated seconds (1 hour = 3600.0s)
EVALUATION_DURATION=3600.0

# ── ARDUINO HARDWARE SERIAL INTERFACE ───────────────────
# Set to "true" when physical Arduino Nano 33 BLE is connected via USB
SERIAL_ENABLED=true
SERIAL_PORT=auto
SERIAL_BAUD_RATE=9600

# ── BACKEND SERVER ──────────────────────────────────────
HOST=0.0.0.0
PORT=8000
