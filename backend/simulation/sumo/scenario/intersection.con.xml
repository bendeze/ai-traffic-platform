<?xml version="1.0" encoding="UTF-8"?>
<connections xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/connections_file.xsd">
    <!-- North Incoming Connections -->
    <connection from="north_in" to="west_out"  fromLane="0" toLane="0"/> <!-- Right -->
    <connection from="north_in" to="south_out" fromLane="0" toLane="0"/> <!-- Straight -->
    <connection from="north_in" to="south_out" fromLane="1" toLane="1"/> <!-- Straight -->
    <connection from="north_in" to="east_out"  fromLane="1" toLane="1"/> <!-- Left -->

    <!-- South Incoming Connections -->
    <connection from="south_in" to="east_out"  fromLane="0" toLane="0"/> <!-- Right -->
    <connection from="south_in" to="north_out" fromLane="0" toLane="0"/> <!-- Straight -->
    <connection from="south_in" to="north_out" fromLane="1" toLane="1"/> <!-- Straight -->
    <connection from="south_in" to="west_out"  fromLane="1" toLane="1"/> <!-- Left -->

    <!-- East Incoming Connections -->
    <connection from="east_in"  to="north_out" fromLane="0" toLane="0"/> <!-- Right -->
    <connection from="east_in"  to="west_out"  fromLane="0" toLane="0"/> <!-- Straight -->
    <connection from="east_in"  to="west_out"  fromLane="1" toLane="1"/> <!-- Straight -->
    <connection from="east_in"  to="south_out" fromLane="1" toLane="1"/> <!-- Left -->

    <!-- West Incoming Connections -->
    <connection from="west_in"  to="south_out" fromLane="0" toLane="0"/> <!-- Right -->
    <connection from="west_in"  to="east_out"  fromLane="0" toLane="0"/> <!-- Straight -->
    <connection from="west_in"  to="east_out"  fromLane="1" toLane="1"/> <!-- Straight -->
    <connection from="west_in"  to="north_out" fromLane="1" toLane="1"/> <!-- Left -->
</connections>

