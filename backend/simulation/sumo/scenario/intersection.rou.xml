<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ====================================================================== -->
    <!-- REALISTIC VEHICLE TYPES WITH DETAILED 2D GRAPHICAL SHAPES              -->
    <!-- Distinct, recognizable silhouettes instead of default triangles        -->
    <!-- ====================================================================== -->
    <vType id="car"
           vClass="passenger"
           guiShape="passenger"
           length="4.5"
           width="1.8"
           maxSpeed="14.0"
           accel="2.6"
           decel="4.5"
           emergencyDecel="7.0"
           apparentDecel="4.5"
           sigma="0.5"
           minGap="2.0"
           color="0.2,0.6,1.0"/>

    <vType id="bus"
           vClass="bus"
           guiShape="bus"
           length="12.0"
           width="2.5"
           maxSpeed="11.0"
           accel="1.3"
           decel="3.5"
           emergencyDecel="6.0"
           apparentDecel="3.5"
           sigma="0.3"
           minGap="2.5"
           color="1.0,0.8,0.0"/>

    <vType id="truck"
           vClass="truck"
           guiShape="truck"
           length="9.0"
           width="2.4"
           maxSpeed="12.0"
           accel="1.5"
           decel="3.8"
           emergencyDecel="6.5"
           apparentDecel="3.8"
           sigma="0.4"
           minGap="2.5"
           color="0.8,0.4,0.1"/>

    <vType id="motorcycle"
           vClass="motorcycle"
           guiShape="motorcycle"
           length="2.2"
           width="0.9"
           maxSpeed="15.0"
           accel="3.5"
           decel="5.0"
           emergencyDecel="8.0"
           apparentDecel="5.0"
           sigma="0.5"
           minGap="1.5"
           color="0.1,0.9,0.3"/>

    <vType id="bicycle"
           vClass="bicycle"
           guiShape="bicycle"
           length="1.8"
           width="0.7"
           maxSpeed="6.5"
           accel="1.5"
           decel="3.0"
           emergencyDecel="5.0"
           apparentDecel="3.0"
           sigma="0.3"
           minGap="1.0"
           color="0.1,0.8,0.9"/>

    <vType id="emergency_ambulance"
           vClass="emergency"
           guiShape="emergency"
           length="6.5"
           width="2.2"
           maxSpeed="18.0"
           accel="3.2"
           decel="5.5"
           emergencyDecel="8.5"
           apparentDecel="5.5"
           sigma="0.2"
           minGap="1.5"
           color="1.0,0.1,0.1"/>

    <!-- ====================================================================== -->
    <!-- INTERSECTION ROUTES (STRAIGHT, LEFT, RIGHT FROM EACH INCOMING ROAD)     -->
    <!-- ====================================================================== -->
    <!-- North Origin -->
    <route id="r_north_to_south" edges="north_in south_out"/>
    <route id="r_north_to_west"  edges="north_in west_out"/>
    <route id="r_north_to_east"  edges="north_in east_out"/>

    <!-- South Origin -->
    <route id="r_south_to_north" edges="south_in north_out"/>
    <route id="r_south_to_east"  edges="south_in east_out"/>
    <route id="r_south_to_west"  edges="south_in west_out"/>

    <!-- East Origin -->
    <route id="r_east_to_west"   edges="east_in west_out"/>
    <route id="r_east_to_north"  edges="east_in north_out"/>
    <route id="r_east_to_south"  edges="east_in south_out"/>

    <!-- West Origin -->
    <route id="r_west_to_east"   edges="west_in east_out"/>
    <route id="r_west_to_south"  edges="west_in south_out"/>
    <route id="r_west_to_north"  edges="west_in north_out"/>

    <!-- ====================================================================== -->
    <!-- CONTINUOUS ASYMMETRIC TRAFFIC FLOWS (HIGHWAY CORRIDOR VS CROSS STREET)  -->
    <!-- Sorted chronologically: begin=0.0 flows come first                      -->
    <!-- ====================================================================== -->
    <!-- North Flows (Cross-Street: ~220 veh/hr) -->
    <flow id="flow_n_s_car"   type="car"        route="r_north_to_south" begin="0" end="7200" vehsPerHour="140" departLane="best" departSpeed="max"/>
    <flow id="flow_n_w_car"   type="car"        route="r_north_to_west"  begin="0" end="7200" vehsPerHour="40"  departLane="best" departSpeed="max"/>
    <flow id="flow_n_e_car"   type="car"        route="r_north_to_east"  begin="0" end="7200" vehsPerHour="30"  departLane="best" departSpeed="max"/>
    <flow id="flow_n_s_bus"   type="bus"        route="r_north_to_south" begin="0" end="7200" vehsPerHour="15"  departLane="best" departSpeed="max"/>
    <flow id="flow_n_s_bike"  type="bicycle"    route="r_north_to_south" begin="0" end="7200" vehsPerHour="15"  departLane="best" departSpeed="max"/>

    <!-- South Flows (Cross-Street: ~210 veh/hr) -->
    <flow id="flow_s_n_car"   type="car"        route="r_south_to_north" begin="0" end="7200" vehsPerHour="130" departLane="best" departSpeed="max"/>
    <flow id="flow_s_e_car"   type="car"        route="r_south_to_east"  begin="0" end="7200" vehsPerHour="40"  departLane="best" departSpeed="max"/>
    <flow id="flow_s_w_car"   type="car"        route="r_south_to_west"  begin="0" end="7200" vehsPerHour="30"  departLane="best" departSpeed="max"/>
    <flow id="flow_s_truck"   type="truck"      route="r_south_to_north" begin="0" end="7200" vehsPerHour="15"  departLane="best" departSpeed="max"/>
    <flow id="flow_s_n_bike"  type="bicycle"    route="r_south_to_north" begin="0" end="7200" vehsPerHour="10"  departLane="best" departSpeed="max"/>

    <!-- East Flows (Main Arterial Corridor: ~730 veh/hr) -->
    <flow id="flow_e_w_car"   type="car"        route="r_east_to_west"   begin="0" end="7200" vehsPerHour="450" departLane="best" departSpeed="max"/>
    <flow id="flow_e_n_car"   type="car"        route="r_east_to_north"  begin="0" end="7200" vehsPerHour="130" departLane="best" departSpeed="max"/>
    <flow id="flow_e_s_car"   type="car"        route="r_east_to_south"  begin="0" end="7200" vehsPerHour="90"  departLane="best" departSpeed="max"/>
    <flow id="flow_e_moto"    type="motorcycle" route="r_east_to_west"   begin="0" end="7200" vehsPerHour="50"  departLane="best" departSpeed="max"/>
    <flow id="flow_e_w_bike"  type="bicycle"    route="r_east_to_west"   begin="0" end="7200" vehsPerHour="20"  departLane="best" departSpeed="max"/>

    <!-- West Flows (Main Arterial Corridor: ~700 veh/hr) -->
    <flow id="flow_w_e_car"   type="car"        route="r_west_to_east"   begin="0" end="7200" vehsPerHour="430" departLane="best" departSpeed="max"/>
    <flow id="flow_w_s_car"   type="car"        route="r_west_to_south"  begin="0" end="7200" vehsPerHour="120" departLane="best" departSpeed="max"/>
    <flow id="flow_w_n_car"   type="car"        route="r_west_to_north"  begin="0" end="7200" vehsPerHour="90"  departLane="best" departSpeed="max"/>
    <flow id="flow_w_bus"     type="bus"        route="r_west_to_east"   begin="0" end="7200" vehsPerHour="45"  departLane="best" departSpeed="max"/>
    <flow id="flow_w_e_bike"  type="bicycle"    route="r_west_to_east"   begin="0" end="7200" vehsPerHour="15"  departLane="best" departSpeed="max"/>

    <!-- ====================================================================== -->
    <!-- INITIAL SEED DEPARTURES (STRICT ASCENDING TIME ORDER)                   -->
    <!-- ====================================================================== -->
    <vehicle id="init_east_1"  type="car"   route="r_east_to_west"   depart="0.5" departLane="best" departSpeed="max"/>
    <vehicle id="init_west_1"  type="car"   route="r_west_to_east"   depart="0.8" departLane="best" departSpeed="max"/>
    <vehicle id="init_north_1" type="car"   route="r_north_to_south" depart="1.0" departLane="best" departSpeed="max"/>
    <vehicle id="init_east_2"  type="car"   route="r_east_to_west"   depart="1.5" departLane="best" departSpeed="max"/>
    <vehicle id="init_west_2"  type="bus"   route="r_west_to_east"   depart="2.0" departLane="best" departSpeed="max"/>
    <vehicle id="init_south_1" type="car"   route="r_south_to_north" depart="2.2" departLane="best" departSpeed="max"/>

    <!-- ====================================================================== -->
    <!-- SCHEDULED EMERGENCY AMBULANCE INJECTIONS FOR PREEMPTION VERIFICATION   -->
    <!-- ====================================================================== -->
    <vehicle id="amb_north_25"  type="emergency_ambulance" route="r_north_to_south" depart="25"  departSpeed="max" departLane="best"/>
    <vehicle id="amb_east_70"   type="emergency_ambulance" route="r_east_to_west"   depart="70"  departSpeed="max" departLane="best"/>
    <vehicle id="amb_south_130" type="emergency_ambulance" route="r_south_to_north" depart="130" departSpeed="max" departLane="best"/>
    <vehicle id="amb_west_190"  type="emergency_ambulance" route="r_west_to_east"   depart="190" departSpeed="max" departLane="best"/>
    <flow id="flow_amb_north_periodic" type="emergency_ambulance" route="r_north_to_south" begin="250" end="7200" period="100" departLane="best" departSpeed="max"/>
    <flow id="flow_amb_east_periodic"  type="emergency_ambulance" route="r_east_to_west"   begin="300" end="7200" period="120" departLane="best" departSpeed="max"/>

</routes>
